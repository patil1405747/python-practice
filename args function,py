#a*args function

#simple *args
def add(*args):
    print(args)
add(10,20,30,40)

#addition *args
def add(*args):
    sum=0
    for i in args:
        sum=sum+i
    print(sum)  
add(10,20,30)    

#print multiple names
def names(*args):
    for i in args:
        print(i)
names("gayatri","anuja","swati")

#Multiplication using *args
def multi(*args):
    result=1
    for i in args:
        result=result*i
        print( "multiplication:",result)
multi(2,3,4,5)     


#find large number
def larger(*args):
    print("larger:",max(args))
larger(23,65,12) 

#** kwargs 
def student(**kwargs):
    print(kwargs)
student(name="gayatri", age=21,city="pune")


#using both *args and **kwargs
def student(*args, **kwargs):
    print("Marks:", args)
    print("Details:", kwargs)

student(80, 90, 85, name="Amit", age=21, city="Belagavi")


